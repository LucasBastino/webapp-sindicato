DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_NAME=
# MySQL TLS: false (default, local), true (verify server cert), or skip-verify.
DB_TLS=false

JWT_SECRET=
# Required at boot. Use a long random string (min 32 characters).
# Example: openssl rand -hex 32

# true by default (assume HTTPS). Set false for local HTTP so the browser accepts cookies.
COOKIE_SECURE=false

APP_PORT="8080"
APP_HOST="0.0.0.0"

LICENSE_PATH="./assets/license/license.json"
PUBLIC_KEY_PATH="./assets/license/public.pem"

BACKUP_DIR="./backups"
